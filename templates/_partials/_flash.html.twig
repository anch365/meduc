{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="mx-auto max-w-4xl mt-4 p-3 rounded 
            {{ label == 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}