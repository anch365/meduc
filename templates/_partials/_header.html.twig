<header class="text-vert-fonce font-semibold pb-2 fixed top-0 left-0 right-0 px-4 border-b border-vert-fonce bg-gray-50 z-30 font-sans md:px-8">
    {% set route = app.current_route %}

    <nav class="flex flex-row justify-between items-center">

        {# ── LOGO : premier enfant de la nav → aligné en ligne, visible sur toutes les tailles ── #}
        <a href="{{ path('app_home') }}" class="flex items-center gap-3">
            <img
                src="{{ asset('imgs/Logo-Meduc.webp') }}"
                alt="Logo MEDUC"
                class="h-10 w-auto mt-2"
            >

            {# ── Titre en 2 lignes ── #}
            <span class="flex flex-col text-green-900 leading-tight">
                <span class="font-bold text-sm md:text-xs lg:text-base">
                    Ministère de l'Éducation
                </span>
                <span class="text-[10px] text-green-900 md:text-xs">
                    de l'Union de Comores
                </span>
            </span>
        </a>

        {# ── Liens DESKTOP : visibles à partir de 1024px (lg), cachés sur mobile ── #}
        <div class="hidden text-black items-center lg:flex lg:gap-4 xl:gap-8 2xl:gap-16">
            <a href="{{ path('app_home') }}" class="btn-header {{ route == 'app_home' ? 'active' : '' }}" aria-label="Bouton d'accueil">Accueil</a>

            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="btn-header {{ route == 'app_admin_dashboard' ? 'active' : '' }}" aria-label="Bouton de profil">Profil</a>

                    <div class="relative group">
                        <button class="btn-header {{ route starts with 'app_enseignant' ? 'active' : '' }}" aria-label="Bouton pour accéder aux options des enseignants">Gestion des enseignants ▾</button>

                        <div class="absolute hidden rounded shadow-lg mt-2 p-4 w-48 bg-menthe group-hover:block group-focus-within:block">
                            <a href="{{ path('app_enseignant_index') }}" class="btn-header block {{ route == 'app_enseignant_index' ? 'active' : '' }}" aria-label="Bouton pour voir la liste des enseignants">Liste des enseignants</a>
                            <a href="{{ path('app_enseignant_new') }}" class="btn-header block {{ route == 'app_enseignant_new' ? 'active' : '' }}" aria-label="Bouton pour créer un enseignant">Créer un enseignant</a>
                            <a href="{{ path('app_enseignant_archives') }}" class="btn-header block {{ route == 'app_enseignant_archives' ? 'active' : '' }}" aria-label="Bouton pour archiver un enseignant">Enseignants archivés</a>
                        </div>
                    </div>

                    <div class="relative group">
                        <button class="btn-header {{ route starts with 'app_etablissement' ? 'active' : '' }}" aria-label="Bouton pour accéder aux options des établissements">Gestion des Établissements ▾</button>

                        <div class="absolute hidden group-hover:block group-focus-within:block rounded shadow-lg mt-2 p-4 w-48 bg-menthe">
                            <a href="{{ path('app_etablissement_index') }}" class="btn-header block {{ route == 'app_etablissement_index' ? 'active' : '' }}" aria-label="Bouton pour voir la liste des établissements">Liste des établissements</a>
                            <a href="{{ path('app_etablissement_new') }}" class="btn-header block {{ route == 'app_etablissement_new' ? 'active' : '' }}" aria-label="Bouton pour créer un établissement">Créer un établissement</a>

                        </div>
                    </div>

                    <div class="relative group">
                        <button class="btn-header {{ route starts with 'app_affectation' ? 'active' : '' }}" aria-label="Bouton pour accéder aux options des affectations">Gestion des affectations ▾</button>

                        <div class="absolute hidden group-hover:block group-focus-within:block rounded shadow-lg mt-2 p-4 w-48 bg-menthe">
                            <a href="{{ path('app_affectation_index') }}" class="btn-header block {{ route == 'app_affectation_index' ? 'active' : '' }}" aria-label="Bouton pour voir la liste des affectations">Liste des affectations</a>
                            <a href="{{ path('app_affectation_new') }}" class="btn-header block {{ route == 'app_affectation_new' ? 'active' : '' }}" aria-label="Bouton pour faire une nouvelle affectation">+ Nouvelle affectation</a>
                        </div>
                    </div>

                    <a href="{{ path('app_localite_index') }}" class="btn-header {{ route == 'app_localite_index' ? 'active' : '' }}" aria-label="Bouton des localités">Localités</a>
                {% else %}
                    <a href="{{ path('app_espace') }}" class="btn-header block {{ route == 'app_espace' ? 'active' : '' }}" aria-label="Bouton pour mon espace">Mon espace</a>
                {% endif %}
                <a href="{{ path('app_logout') }}" class="rounded-xs px-2 py-2 text-red-600 hover:text-white hover:bg-red-600" aria-label="Bouton pour se déconnecter">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-header {{ route == 'app_login' ? 'active' : '' }}" aria-label="Bouton pour se connecter">Se connecter</a>
            {% endif %}
        </div>

        {# ── Bouton burger ☰ : visible UNIQUEMENT sur mobile (lg:hidden) ── #}
        <button id="menu-burger" class="lg:hidden text-2xl" aria-label="Ouvrir le menu">
            ☰
        </button>
    </nav>
</header>

{# ══════════ MENU BURGER ══════════ #}

{# 1. Fond noir transparent : couvre tout l'écran, en dessous de la fenêtre #}
<div id="menu-overlay" class="hidden fixed inset-0 bg-black/50 z-40 lg:hidden"></div>

{# 2. Fenêtre d'options : collée à droite, AU-DESSUS du fond (z-50 > z-40) #}
<div id="menu-mobile" class="hidden fixed top-0 right-0 h-full w-56 bg-white shadow-2xl z-50 overflow-y-auto lg:hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-menthe">
        <span class="font-bold text-vert-fonce">Menu</span>
        <button id="menu-close" class="text-2xl text-vert-fonce" aria-label="Fermer le menu">✕</button>
    </div>

    <nav class="flex flex-col">
        <a href="{{ path('app_home') }}" class="btn-header mt-4 ml-4 {{ route == 'app_home' ? 'active' : '' }}">Accueil</a>

        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-3 btn-header {{ route == 'app_admin_dashboard' ? 'active' : '' }}">Profil</a>
                <a href="{{ path('app_enseignant_index') }}" class="px-4 py-3 btn-header {{ route == 'app_enseignant_index' ? 'active' : '' }}">Liste des enseignants</a>
                <a href="{{ path('app_enseignant_new') }}" class="px-4 py-3 btn-header {{ route == 'app_enseignant_new' ? 'active' : '' }}">Créer un enseignant</a>
                <a href="{{ path('app_enseignant_archives') }}" class="px-4 py-3 btn-header {{ route == 'app_enseignant_archives' ? 'active' : '' }}">Enseignants archivés</a>
                <a href="{{ path('app_etablissement_index') }}" class="px-4 py-3 btn-header {{ route == 'app_etablissement_index' ? 'active' : '' }}">Liste des établissements</a>
                <a href="{{ path('app_etablissement_new') }}" class="px-4 py-3 btn-header {{ route == 'app_etablissement_new' ? 'active' : '' }}">Créer un établissement</a>
                <a href="{{ path('app_affectation_index') }}" class="px-4 py-3 btn-header {{ route == 'app_affectation_index' ? 'active' : '' }}">Liste des affectations</a>
                <a href="{{ path('app_affectation_new') }}" class="px-4 py-3 btn-header {{ route == 'app_affectation_new' ? 'active' : '' }}">+ Nouvelle affectation</a>
                <a href="{{ path('app_localite_index') }}" class="px-4 py-3 btn-header {{ route == 'app_localite_index' ? 'active' : '' }}">Localités</a>
            {% else %}
                <a href="{{ path('app_espace') }}" class="px-4 py-3 btn-header {{ route == 'app_espace' ? 'active' : '' }}">Mon espace</a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="px-4 py-3 btn-header {{ route == 'app_logout' ? 'active' : '' }} text-red-700">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="px-4 py-3 btn-header {{ route == 'app_login' ? 'active' : '' }}">Se connecter</a>
        {% endif %}
    </nav>
</div>
