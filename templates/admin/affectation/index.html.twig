{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block title %}Affectations — MEDUC{% endblock %}

{% block body %}
    {# ── Macro : un en-tête triable réutilisable (DRY) ── #}
    {% macro sortable(label, field, sort, order, search) %}
        {% set active = sort == field %}
        {% set nextOrder = active and order == 'ASC' ? 'DESC' : 'ASC' %}
        <a
            href="{{ path('app_affectation_index', {sort: field, order: nextOrder, q: search, page: 1}) }}"
            class="group inline-flex items-center gap-2 hover:text-vert transition"
            aria-label="Trier par {{ label }}{% if active %}, actuellement {{ order == 'ASC' ? 'croissant' : 'décroissant' }}{% endif %}"
        >

            {# ── Le libellé : actif = vert foncé + gras, sinon gris (vert au survol) ── #}
            <span class="{{ active ? 'text-vert-fonce font-semibold' : 'text-slate-700 group-hover:text-vert' }}">
                {{ label }}
            </span>

            {# ── Le double chevron : les 2 triangles, seul l'actif est vert ── #}
            <span class="flex flex-col text-[9px] leading-none" aria-hidden="true">
                <span class="{{ active and order == 'ASC' ? 'text-vert' : 'text-slate-300' }}">▲</span>
                <span class="{{ active and order == 'DESC' ? 'text-vert' : 'text-slate-300' }}">▼</span>
            </span>
        </a>
    {% endmacro %}
    <main class="px-4 py-8 md:px-8 lg:px-16">

        {# ══════════ EN-TÊTE ══════════ #}
        <div class="flex flex-col justify-between gap-4 mb-6 sm:flex-row sm:items-center">
            <div>
                <h1 class="font-display text-2xl font-bold text-vert-fonce">Les affectations</h1>
            </div>
            <a href="{{ path('app_affectation_new') }}" class="btn-adm">+ Nouvelle affectation</a>
        </div>

        {# ══════════ BARRE DE RECHERCHE ══════════ #}
        <form method="get" action="{{ path('app_affectation_index') }}" class="mb-6">

            {# On conserve le tri courant pendant la recherche (sinon il se perd) #}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="order" value="{{ order }}">

            {# ── BARRE "PILULE" (identique aux autres listes : cohérence !) ── #}
            <div class="flex items-center gap-2 border-2 border-bleu/70 bg-white pl-4 h-11.5 rounded-full overflow-hidden max-w-md w-full transition focus-within:border-bleu focus-within:ring focus-within:ring-bleu/10">

                {# L'icône = le bouton de recherche (SVG, plus de PNG) #}
                <button type="submit" aria-label="Lancer la recherche" class="shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 30 30" fill="#6B7280" aria-hidden="true">
                        <path d="M13 3C7.489 3 3 7.489 3 13s4.489 10 10 10a9.95 9.95 0 0 0 6.322-2.264l5.971 5.971a1 1 0 1 0 1.414-1.414l-5.97-5.97A9.95 9.95 0 0 0 23 13c0-5.511-4.489-10-10-10m0 2c4.43 0 8 3.57 8 8s-3.57 8-8 8-8-3.57-8-8 3.57-8 8-8"/>
                    </svg>
                </button>

                <input
                    type="search"
                    name="q"
                    value="{{ search }}"
                    placeholder="Rechercher un enseignant, une classe, une matière…"
                    class="w-full h-full outline-none text-slate-800 placeholder-slate-400 bg-transparent text-sm"
                >
            </div>

            {% if search %}
                <a href="{{ path('app_affectation_index') }}" class="btn-header text-center mt-3 inline-block">
                    Effacer la recherche
                </a>
            {% endif %}
        </form>
        {# ══════════ TABLEAU ══════════ #}
        <div class="bg-white rounded-lg shadow-md px-2 py-6 border-t border-vert-fonce">
            <div class="overflow-x-auto">
                <table class="min-w-175 w-full text-left">
                    <thead>
                        <tr class="border-b-2 border-vert-fonce">
                            <th class="px-4 py-3">Enseignant</th>
                            <th class="px-4 py-3">{{ m.sortable('Établissement', 'etablissement', 'app_affectation_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">{{ m.sortable('Classe', 'classe', 'app_affectation_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">{{ m.sortable('Matière', 'matiere', 'app_affectation_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">{{ m.sortable('Début', 'debut', 'app_affectation_index', sort, order, search) }}</th>                            <th class="px-4 py-3">Fin</th>
                            <th class="px-4 py-3">Statut</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bleu/40">
                        {% for affectation in affectations %}
                            <tr class="hover:bg-menthe transition">
                                <td class="px-4 py-3 font-semibold">
                                    {{ affectation.enseignant.utilisateur.prenom }} {{ affectation.enseignant.utilisateur.nom }}
                                </td>
                                <td class="px-4 py-3">{{ affectation.etablissement.nom }}</td>
                                <td class="px-4 py-3">{{ affectation.classe }}</td>
                                <td class="px-4 py-3">{{ affectation.matiere }}</td>
                                <td class="px-4 py-3">{{ affectation.dateDebut|date('d/m/Y') }}</td>
                                <td class="px-4 py-3">{{ affectation.dateFin ? affectation.dateFin|date('d/m/Y') : '—' }}</td>
                                <td class="px-4 py-3">
                                    {% if affectation.statut == 'en_cours' %}
                                        <span class="bg-vert/15 text-vert-fonce font-semibold text-xs sm:px-2 py-1 rounded-full">En cours</span>
                                    {% elseif affectation.statut == 'terminee' %}
                                        <span class="bg-slate-200 text-slate-700 font-semibold text-xs sm:px-2 py-1 rounded-full">Terminée</span>
                                    {% else %}
                                        <span class="bg-red-100 text-red-700 font-semibold text-xs sm:px-2 py-1 rounded-full">Annulée</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <a href="{{ path('app_affectation_transfert', {'id': affectation.id}) }}" class="">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="w-5 h-5"
                                            aria-hidden="true"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
                                            />
                                        </svg>
                                            
                                    </a>                                
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="px-4 py-12 text-center">
                                    <p class="text-4xl mb-2">🔍</p>
                                    <p class="text-slate-600 font-semibold">
                                        {{ search ? 'Aucun résultat pour « ' ~ search ~ ' »' : 'Aucune affectation' }}
                                    </p>
                                    {% if search %}
                                        <a href="{{ path('app_affectation_index') }}" class="btn mt-4">Effacer la recherche</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ══════════ PAGINATION (macro partagée) ══════════ #}
            {{ m.pagination('app_affectation_index', page, totalPages, search, sort, order) }}        </div>
    </main>

    {% include '_partials/_footer.html.twig' %}  
     
{% endblock %}
