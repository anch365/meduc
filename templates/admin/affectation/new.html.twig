{% extends 'base.html.twig' %}

{% block title %}Nouvelle affectation — MEDUC{% endblock %}

{% block body %}
    <section class="pb-16 md:px-16 lg:px-40 2xl:px-48">
        {# ══════════ EN-TÊTE ══════════ #}
        <div class="mb-6">
            <a
                href="{{ path('app_affectation_index') }}"
                class="inline-flex items-center gap-2 rounded-lg border border-blue-200
               bg-white px-4 py-2.5 text-sm font-semibold text-blue-700
                transition-colors hover:bg-blue-50 
                focus-visible:outline-none focus-visible:ring-2
                focus-visible:ring-blue-600 focus-visible:ring-offset-2 mb-16">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5"/>
                    <path d="m12 19-7-7 7-7"/>
                </svg>

                <span>Retour</span>
            </a>            
            <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">Nouvelle affectation</h1>
            <p class="text-slate-600 text-sm mt-1">
                Affectez un enseignant à un établissement, avec sa classe et sa matière.
            </p>
        </div>

        {# ⭐ novalidate : tes erreurs Symfony s'affichent #}
        {{ form_start(form, {attr: {novalidate: true}}) }}

        {# ══════════ BANDEAU : LES RÈGLES MÉTIER, AVANT D'AGIR ══════════ #}
        <div class="bg-bleu/10 border border-bleu/40 text-slate-700 rounded p-3 text-sm mb-6">
            💡 Règles métier :
            <ul class="list-disc list-inside mt-1">
                <li>Un enseignant ne peut avoir qu'<strong>une seule affectation en cours</strong>
                    — s'il en a déjà une, la création sera refusée.</li>
                <li>Un enseignant <strong>retraité</strong> (64 ans et plus) ne peut pas être affecté.</li>
                <li>Laissez la date de fin <strong>vide</strong> pour une affectation en cours.</li>
            </ul>
        </div>

        {# ══════════ CARTE : LES 6 CHAMPS ══════════ #}
        <section class="flex flex-col gap-4 bg-white rounded-lg shadow-md p-6 border-t border-green-800 mb-6 lg:px-16 2xl:px-40">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Affectation</h2>

            <div class="flex flex-col gap-4 mt-4">
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
                    {{ form_row(form.enseignant) }}
                    {{ form_row(form.etablissement) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
                    {{ form_row(form.classe) }}
                    {{ form_row(form.matiere) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
                    {{ form_row(form.dateDebut) }}
                </div>
            </div>       
            {# ══════════ ACTIONS ══════════ #}
            <div class="flex flex-col gap-4 sm:flex-row">
                <button type="submit" class="btn-adm">Créer l'affectation</button>
                <a href="{{ path('app_affectation_index') }}" class="border-2 py-2 px-4 items-center justify-center rounded text-center text-white bg-red-500 hover:bg-red-600">Annuler</a>
            </div>

        </section>


        {{ form_end(form) }}
    </section>
{% endblock %}
