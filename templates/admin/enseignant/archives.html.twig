{% extends 'base.html.twig' %}

{% block title %}Enseignants archivés — MEDUC{% endblock %}

{% block body %}
    <main class="px-4 py-8 md:px-8 lg:px-16">

        {# ══════════ EN-TÊTE ══════════ #}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <a href="{{ path('app_enseignant_index') }}" class="text-sm text-vert hover:underline">
                    <img src="{{ asset('/Icônes/retour.svg') }}" alt="Bouton en icone de reotur à la lsite des enseignants" class="w-8 md:w-16">
                </a>
                <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">
                    Enseignants archivés
                </h1>
                <p class="text-slate-600 text-sm mt-1">
                    {{ enseignants|length }} compte(s) désactivé(s) — désarchivez pour réactiver l'accès.
                </p>
            </div>
        </div>

        {# ══════════ BANDEAU D'INFORMATION ══════════ #}
        <div class="bg-bleu/10 border border-bleu/40 text-slate-700 rounded p-3 text-sm mb-6">
            💡 Un enseignant archivé ne peut plus se connecter : le compte est bloqué à la connexion.
        </div>

        {# ══════════ TABLEAU (même pattern que la liste active) ══════════ #}
        <div class="bg-white rounded-lg shadow-md p-6 border border-green-900">
            <div class="overflow-x-auto">
                <table class="min-w-150 w-full text-left">
                    <thead>
                        <tr class="border-b-2 border-vert-fonce">
                            <th class="px-4 py-3">Matricule</th>
                            <th class="px-4 py-3">Nom</th>
                            <th class="px-4 py-3">Prénom</th>
                            <th class="px-4 py-3">Email</th>
                            <th class="px-4 py-3">Statut</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bleu/40">
                        {% for enseignant in enseignants %}
                            <tr class="hover:bg-menthe transition">
                                <td class="px-4 py-3">{{ enseignant.utilisateur.matricule }}</td>
                                <td class="px-4 py-3">{{ enseignant.utilisateur.nom }}</td>
                                <td class="px-4 py-3">{{ enseignant.utilisateur.prenom }}</td>
                                <td class="px-4 py-3">{{ enseignant.utilisateur.email }}</td>
                                <td class="px-4 py-3">
                                    <span class="bg-red-100 text-red-700 font-semibold text-xs px-2 py-1 rounded-full">
                                        Archivé
                                    </span>
                                    {% if enseignant.estRetraite %}
                                        <span class="bg-bleu/20 text-vert-fonce border border-bleu font-semibold text-xs px-2 py-1 rounded-full">
                                            Retraité
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-between items-center gap-2">
                                        <a href="{{ path('app_enseignant_show', {'id': enseignant.id}) }}" class="btn-voir">                                            
                                            <img src="{{ asset('/Icônes/voir.png') }}" alt="Icône oeil pour voir les informations d'un enseignant archivé" class="w-8 md:w-6">
                                        </a>

                                        {# ⭐ L'action INVERSÉE : Désarchiver (POST + CSRF) #}
                                        <form
                                            method="post"
                                            action="{{ path('app_enseignant_desarchiver', {'id': enseignant.id}) }}"
                                            onsubmit="return confirm('Réactiver {{ enseignant.utilisateur.prenom }} {{ enseignant.utilisateur.nom }} ?');"
                                        >
                                            <input type="hidden" name="_token" value="{{ csrf_token('desarchiver' ~ enseignant.id) }}">
                                            <button>                                            
                                                <img src="{{ asset('/Icônes/désarchiver.png') }}" alt="Icône pour désarchiver un enseignant" class="w-8 md:w-6">
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            {# ══════════ ÉTAT VIDE : la page dit qu'il n'y a rien ══════════ #}
                            <tr>
                                <td colspan="6" class="px-4 py-12 text-center">
                                    <p class="text-4xl mb-2">🎉</p>
                                    <p class="text-slate-600 font-semibold">Aucun enseignant archivé</p>
                                    <p class="text-slate-500 text-sm mt-1">Tous les comptes sont actifs.</p>
                                    <a href="{{ path('app_enseignant_index') }}" class="btn mt-4" aria-label="Bouton de retour à la liste des enseignants">Retour à la liste</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    {% include '_partials/_footer.html.twig' %}   

{% endblock %}
