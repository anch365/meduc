{% extends 'base.html.twig' %}

{% block title %}Liste des enseignants — MEDUC{% endblock %}

{% block body %}
    {% import 'macros.html.twig' as m %}
    <main class="px-4 py-8 md:px-8 lg:px-16">

        {# ══════════ 1. EN-TÊTE : titre + compteur + action ══════════ #}
        <div class="flex flex-col gap-4 mb-6 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="font-display text-2xl md:text-3xl font-bold text-vert-fonce">
                    Liste des enseignants
                </h1>
                <p class="text-slate-600 mt-1">
                    {{ enseignants|length }} enseignant(s)
                </p>
            </div>

            <a href="{{ path('app_enseignant_new') }}" class="btn-adm text-center whitespace-nowrap">
                + Créer un enseignant
            </a>
        </div>

        <form method="get" action="{{ path('app_enseignant_index') }}" class="mb-6">

            {# On conserve le tri courant pendant la recherche (sinon il se perd) #}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="order" value="{{ order }}">

            {# ── BARRE "PILULE" (identique aux établissements : cohérence !) ── #}
            <div class="flex items-center gap-2 border-2 border-bleu/70 bg-white pl-4 h-11.5 rounded-full overflow-hidden max-w-md w-full transition focus-within:border-bleu focus-within:ring focus-within:ring-bleu/10">

                <button type="submit" aria-label="Lancer la recherche" class="shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 30 30" fill="#6B7280" aria-hidden="true">
                        <path d="M13 3C7.489 3 3 7.489 3 13s4.489 10 10 10a9.95 9.95 0 0 0 6.322-2.264l5.971 5.971a1 1 0 1 0 1.414-1.414l-5.97-5.97A9.95 9.95 0 0 0 23 13c0-5.511-4.489-10-10-10m0 2c4.43 0 8 3.57 8 8s-3.57 8-8 8-8-3.57-8-8 3.57-8 8-8"/>
                    </svg>
                </button>

                <input
                    type="search"
                    name="q"
                    value="{{ search }}"
                    placeholder="Rechercher par nom, prénom, matricule…"
                    class="w-full h-full outline-none text-slate-800 placeholder-slate-400 bg-transparent text-sm"
                >
            </div>

            {% if search %}
                <a href="{{ path('app_enseignant_index') }}" class="btn-header text-center mt-3 inline-block">
                    Effacer la recherche
                </a>
            {% endif %}
        </form>
        {# ══════════ 2. LA CARTE (contient le tableau) ══════════ #}
        <div class="bg-white rounded-lg shadow-md overflow-hidden">

            {# ══════════ 3. TABLEAU (scrollable sur mobile) ══════════ #}
            <div class="overflow-x-auto mb-8">
                <table class="min-w-175 w-full text-center">
                    <thead>
                        <tr class="border-b-2 border-vert-fonce">
                            <th class="px-4 py-3">{{ m.sortable('Matricule', 'matricule', 'app_enseignant_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">{{ m.sortable('Nom', 'nom', 'app_enseignant_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">École actuelle</th>
                            <th class="px-4 py-3">Statut</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bleu/30">
                        {% for enseignant in enseignants %}
                        
                            <tr class="hover:bg-menthe transition">
                                <td class="px-2 py-3 font-mono text-sm">{{ enseignant.utilisateur.matricule }}</td>
                                <td class="px-4 py-3 font-semibold">
                                    {{ enseignant.utilisateur.prenom }} {{ enseignant.utilisateur.nom }}
                                </td>

                                <td class=" py-3">
                                    {% if enseignant.affectationActive %}
                                        {{ enseignant.affectationActive.etablissement.nom }}
                                    {% else %}
                                        <span class="text-slate-400">—</span>
                                    {% endif %}
                                </td>          

                                <td class="px-4 py-3">
                                    {% if enseignant.estRetraite %}
                                        <span class="inline-block text-red-700 text-sm font-semibold px-4 py-2 rounded">Retraité</span>
                                    {% elseif enseignant.affectationActive %}
                                        <span class="inline-block text-green-700 text-sm font-semibold px-2 py-1 rounded">En poste</span>
                                    {% else %}
                                        <span class="inline-block text-slate-700 text-sm font-semibold px-1 py-1 rounded">Non affecté</span>
                                    {% endif %}
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-6 ">
                                        <a href="{{ path('app_enseignant_show', {'id': enseignant.id}) }}" class="btn-voir">
                                            <img src="{{ asset('/Icônes/voir.png') }}" alt="Icône oeil pour voir les informations de l'enseignant" class="w-8 md:w-6">
                                        </a>
                                        <a href="{{ path('app_enseignant_edit', {'id': enseignant.id}) }}">
                                            <img src="{{ asset('Icônes/editer.png') }}" alt="Icône pour modifier les informations de l'enseignant" class="w-8 md:w-6">
                                        </a>

                                        {# ── Archiver / Désarchiver : POST + jeton CSRF (pattern n°8 de ta fiche jury !) ── #}
                                        {% if enseignant.utilisateur.actif %}
                                            <form
                                                method="post"
                                                action="{{ path('app_enseignant_archive', {'id': enseignant.id}) }}"
                                                onsubmit="return confirm('Archiver {{ enseignant.utilisateur.prenom }} {{ enseignant.utilisateur.nom }} ?');"
                                            >
                                                <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ enseignant.id) }}">
                                                <button><img src="{{ asset('/Icônes/archiver.svg') }}" alt="Icône pour archiver un enseignant" class="w-8 md:w-6"></button>
                                            </form>
                                        {% else %}
                                            <form
                                                method="post"
                                                action="{{ path('app_enseignant_desarchiver', {'id': enseignant.id}) }}"
                                                onsubmit="return confirm('Réactiver {{ enseignant.utilisateur.prenom }} {{ enseignant.utilisateur.nom }} ?');"
                                            >
                                                <input type="hidden" name="_token" value="{{ csrf_token('desarchiver' ~ enseignant.id) }}">
                                                <button class="btn">Désarchiver</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            {# ══════════ ÉTAT VIDE : aucune ligne ══════════ #}
                            <tr>
                                <td colspan="6" class="px-4 py-12 text-center text-slate-500">
                                    Aucun enseignant trouvé.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {{ m.pagination('app_enseignant_index', page, totalPages, search, sort, order) }}
            </div>
        </div>
    </main>
    
    {% include '_partials/_footer.html.twig' %}   

{% endblock %}
