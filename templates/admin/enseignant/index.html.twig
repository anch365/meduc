{% extends 'base.html.twig' %}

{% block title %}Liste des enseignants{% endblock %}

{% block body %}
    <h1>Liste des enseignants</h1>

    <a href="{{ path('app_enseignant_new') }}">+ Créer un enseignant</a>
    <a href="{{ path('app_enseignant_archives') }}">Voir les archivés</a>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Matricule</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for enseignant in enseignants %}
                <tr>
                    <td>{{ enseignant.utilisateur.nom }}</td>
                    <td>{{ enseignant.utilisateur.prenom }}</td>
                    <td>{{ enseignant.utilisateur.matricule }}</td>
                    <td>{{ enseignant.utilisateur.email }}</td>
                    <td>
                        <a href="{{ path('app_enseignant_edit', {id: enseignant.id}) }}">Modifier</a>
                        <a href="{{ path('app_enseignant_show', {id: enseignant.id}) }}">Voir</a>
                        <form
                            method="post"
                            action="{{ path('app_enseignant_archive', {id: enseignant.id}) }}"
                            onsubmit="return confirm('Archiver cet enseignant ?');"
                            style="display:inline;"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ enseignant.id) }}">
                            <button type="submit">Archiver</button>
                        </form>
                    </td>                </tr>
            {% else %}
                <tr><td colspan="4">Aucun enseignant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
