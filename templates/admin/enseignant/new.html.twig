{% extends 'base.html.twig' %}

{% block title %}Créer un enseignant — MEDUC{% endblock %}

{% block body %}
    <section class="pb-16 md:px-16">
        {# ══════════ EN-TÊTE : bouton retour + titre ══════════ #}
        <div class="mb-6">
            <a
                href="{{ path('app_enseignant_index') }}"
                class="inline-flex items-center gap-2 rounded-lg border border-blue-200
               bg-white px-4 py-2.5 text-sm font-semibold text-blue-700
                transition-colors hover:bg-blue-50 
                focus-visible:outline-none focus-visible:ring-2
                focus-visible:ring-blue-600 focus-visible:ring-offset-2 mb-16" aria-label="Bouton de retour">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5"/>
                    <path d="m12 19-7-7 7-7"/>
                </svg>

                <span>Retour</span>
            </a>            
            <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">Créer un enseignant</h1>
            <p class="text-slate-600 text-sm mt-1">
                Renseignez le compte de connexion et le profil administratif.
            </p>
        </div>

        {# ⭐ novalidate : pour que TES erreurs Symfony s'affichent (leçon M12.1) #}
        {{ form_start(form, {attr: {novalidate: true}}) }}

        {# ══════════ CARTE 1 : COMPTE DE CONNEXION (UtilisateurType) ══════════ #}
        <section class="bg-white rounded-lg shadow-md p-6 border border-green-800 mb-6 lg:px-32">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Compte de connexion</h2>
        
            <p class="text-slate-500 text-sm mb-4">
                L'enseignant s'identifiera avec son email ou son matricule.
            </p>

            <div class="flex flex-col gap-4 mt-4 2xl:flex-row 2xl:justify-between 2xl:px-16">

                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.utilisateur.matricule) }}
                    {{ form_row(form.utilisateur.email) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.utilisateur.nom) }}
                    {{ form_row(form.utilisateur.prenom) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.utilisateur.telephone) }}
                    {{ form_row(form.utilisateur.plainPassword) }}
                </div>
            </div>
        </section>


        {# ══════════ CARTE 2 : PROFIL ADMINISTRATIF (EnseignantType) ══════════ #}
        <section class="bg-white rounded-lg shadow-md p-6 border border-green-800 mb-6 lg:px-32">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Profil administratif</h2>
            <p class="text-slate-500 text-sm mb-4">
                Informations métier de l'enseignant.
            </p>

            <div class="flex flex-col gap-4 mt-4 2xl:flex-row 2xl:justify-between 2xl:px-16">
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.genre) }}
                    {{ form_row(form.dateNaissance) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.lieuNaissance) }}
                    {{ form_row(form.niveauEnseignement) }}
                </div>
                <div class="flex flex-col gap-4 sm:flex-row sm:justify-between 2xl:flex-col">
                    {{ form_row(form.statutProfessionnel) }}
                    {{ form_row(form.localite) }}
                </div>
            </div>
        </section>
        {# ══════════ BOUTONS ══════════ #}
        <div class="flex flex-col gap-4 sm:flex-row">
            <button type="submit" class="btn-adm" aria-label="Bouton pour confirmer la création d'un enseignant">Créer l'enseignant</button>
            <a href="{{ path('app_enseignant_index') }}" aria-label="Bouton d'annulation" class="border-2 py-2 px-4 items-center justify-center rounded text-center text-white bg-red-500 hover:bg-red-600" aria-label="Bouton d'annulation">Annuler</a>
        </div>

        {{ form_end(form) }}
    </section>
{% endblock %}
