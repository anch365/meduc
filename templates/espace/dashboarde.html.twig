{% extends 'base.html.twig' %}

{% block title %}Mon espace — MEDUC{% endblock %}

{% block body %}
    <section class="flex flex-col gap-8 px-4 py-8 md:px-8 lg:px-16 2xl:px-40">

        {# ══════════ EN-TÊTE ══════════ #}
        <div>
            <h1 class="font-display text-2xl font-bold text-green-800">Mon espace</h1>
            <p class="text-slate-600 text-sm mt-1">
                Bonjour, {{ app.user.prenom }} — voici votre dossier.
            </p>
        </div>

        {# ══════════ MES INFORMATIONS ══════════ #}
        <section class="flex flex-col gap-4 md:flex-row md:justify-between 2xl:px-32">
            
            <div class="bg-white rounded-lg shadow-md px-4 py-4 border-t border-green-900 md:w-full 2xl:px-16">
                <h2 class="font-display text-xl font-bold text-green-800">Mes informations</h2>

                <div class="flex flex-row flex-wrap mt-4 justify-between items-center">
                    <div class="flex flex-col gap-4 md:gap-16">
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Nom complet</dt>
                            <dd class="font-semibold">{{ app.user.prenom }} {{ app.user.nom }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Matricule</dt>
                            <dd class="font-semibold">{{ app.user.matricule }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Email</dt>
                            <dd class="font-semibold">{{ app.user.email }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Téléphone</dt>
                            <dd class="font-semibold">{{ app.user.telephone ?? '—' }}</dd>
                        </div>
                    </div>

                    <div class="flex flex-col gap-4 md:gap-16">
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Genre</dt>
                            <dd class="font-semibold">{{ enseignant.genre }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Date de naissance</dt>
                            <dd class="font-semibold">{{ enseignant.dateNaissance ? enseignant.dateNaissance|date('d/m/Y') : '—' }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Âge</dt>
                            <dd class="font-semibold">{{ enseignant.age }} ans</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-sm text-slate-500">Lieu de naissance</dt>
                            <dd class="font-semibold">{{ enseignant.lieuNaissance ?? '—' }}</dd>
                        </div>
                    </div>
                </div>
            </div>

            {# ══════════ MON AFFECTATION ACTUELLE ══════════ #}
            <div class="bg-white rounded-lg shadow-md p-6 border-t border-green-900 md:w-full 2xl:px-16">
                <h2 class="font-display text-xl font-bold text-vert-fonce">Mon affectation actuelle</h2>

                {% if affectationActive %}
                    <div class="flex flex-col gap-4 mt-4">
                        <div class="bg-menthe rounded p-4">
                            <p class="text-xs text-slate-500">Établissement</p>
                            <p class="font-semibold mt-1">{{ affectationActive.etablissement.nom }}</p>
                        </div>
                        <div class="bg-menthe rounded p-4">
                            <p class="text-xs text-slate-500">Classe</p>
                            <p class="font-semibold mt-1">{{ affectationActive.classe }}</p>
                        </div>
                        <div class="bg-menthe rounded p-4">
                            <p class="text-xs text-slate-500">Matière</p>
                            <p class="font-semibold mt-1">{{ affectationActive.matiere }}</p>
                        </div>
                        <div class="bg-menthe rounded p-4">
                            <p class="text-xs text-slate-500">Depuis le</p>
                            <p class="font-semibold mt-1">{{ affectationActive.dateDebut|date('d/m/Y') }}</p>
                        </div>
                    </div>
                {% else %}
                    <p class="text-slate-500 mt-4 bg-menthe rounded p-4">
                        Vous n'avez pas d'affectation en cours.
                    </p>
                {% endif %}
            </div>
        </section>

        {# ══════════ ACTIONS ══════════ #}
        <div class="flex flex-wrap gap-4">
            <a href="{{ path('app_espace_mot_de_passe') }}" class="px-4 py-2 rounded-lg bg-slate-600 hover:bg-slate-700 text-white" aria-label="Bouton pour changer mon mot de passe">Changer mon mot de passe</a>

            <a href="{{ path('app_espace_historique') }}" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-center" aria-label="Bouton pour voir l'historique de mes affectations">
                Voir mon historique ({{ historique|length }})
            </a>
        </div>

    </section>

{% endblock %}
