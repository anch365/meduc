{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}
    <h1>Mon espace</h1>

    <table>
        <tr><th>Nom</th><td>{{ enseignant.utilisateur.nom }}</td></tr>
        <tr><th>Prénom</th><td>{{ enseignant.utilisateur.prenom }}</td></tr>
        <tr><th>Date de naissance</th><td>{{ enseignant.dateNaissance|date('d/m/Y') }}</td></tr>
        <tr><th>Âge</th><td>{{ enseignant.age }} ans</td></tr>
        <tr><th>Genre</th><td>{{ enseignant.genre }}</td></tr>
        <tr><th>Matricule</th><td>{{ enseignant.utilisateur.matricule }}</td></tr>
        <tr>
            <th>Statut</th>
            <td>
                {% if enseignant.estRetraite %}
                    <strong>Retraité</strong>
                {% else %}
                    Actif
                {% endif %}
            </td>
        </tr>
    </table>

    <p><a href="{{ path('app_espace_mot_de_passe') }}">Modifier mon mot de passe</a></p>

    <h2>Établissement actuel</h2>
    {% if affectationActive %}
        <p>
            <strong>{{ affectationActive.etablissement.nom }}</strong>
            ({{ affectationActive.classe }} — {{ affectationActive.matiere }})
            depuis le {{ affectationActive.dateDebut|date('d/m/Y') }}
        </p>
    {% else %}
        <p><em>Non affecté actuellement.</em></p>
    {% endif %}

    <h2>Mon historique d'affectations</h2>

    {% if historique is empty %}
        <p><em>Aucune affectation.</em></p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Établissement</th>
                    <th>Classe</th>
                    <th>Matière</th>
                    <th>Début</th>
                    <th>Fin</th>
                </tr>
            </thead>
            <tbody>
                {% for affectation in historique %}
                    <tr>
                        <td>{{ affectation.etablissement.nom }}</td>
                        <td>{{ affectation.classe }}</td>
                        <td>{{ affectation.matiere }}</td>
                        <td>{{ affectation.dateDebut|date('d/m/Y') }}</td>
                        <td>
                            {% if affectation.dateFin %}
                                {{ affectation.dateFin|date('d/m/Y') }}
                            {% else %}
                                <strong>En cours</strong>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
