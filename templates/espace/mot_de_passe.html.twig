{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe — MEDUC{% endblock %}

{% block body %}
    <main class="px-4 py-8 sm:px-32 md:px-40 lg:px-48">

        {# ══════════ EN-TÊTE : retour vers l'espace ══════════ #}
        <div class="mb-6">
            <a href="{{ path('app_espace') }}" class="text-sm text-vert hover:underline">
                ← Retour à mon espace
            </a>
            <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">Changer mon mot de passe</h1>
            <p class="text-slate-600 text-sm mt-1">
                Votre nouveau mot de passe doit contenir au moins 8 caractères.
            </p>
        </div>

        {# ⭐ novalidate : tes erreurs Symfony s'affichent #}
        {{ form_start(form, {attr: {novalidate: true}}) }}

        {# ══════════ CARTE UNIQUE ══════════ #}
        <section class="bg-white rounded-lg shadow-md p-6 border-t border-green-900 mb-6 sm:px-16 lg:mx-40">
            <div>
                <h2 class="font-display text-xl font-bold text-vert-fonce">Sécurité du compte</h2>

                <div class="flex flex-col gap-4 mt-4">
                    {{ form_row(form.ancienMotDePasse) }}
                    {{ form_row(form.nouveauMotDePasse) }}
                </div>
            </div>

            {# ══════════ ACTIONS ══════════ #}
            <div class="flex flex-col gap-4 sm:flex-row">
                <button type="submit" class="btn-adm">Mettre à jour</button>
                <a href="{{ path('app_espace') }}" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-center">Annuler</a>
            </div>
        </section>
        {{ form_end(form) }}
    </main>

    {% include '_partials/_footer.html.twig' %}   

{% endblock %}
