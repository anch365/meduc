{% extends 'base.html.twig' %}

{% block title %}Établissements — MEDUC{% endblock %}

{% block body %}
    {% import 'macros.html.twig' as m %}
    <main class="container mx-auto px-4 py-8">

        {# ══════════ EN-TÊTE : titre + compteur + bouton créer ══════════ #}
        <div class="flex flex-col justify-between gap-4 mb-6 sm:flex-row sm:items-center">
            <div>
                <h1 class="font-display text-2xl font-bold text-vert-fonce">Établissements</h1>
                <p class="text-slate-600 text-sm mt-1">
                    {{ etablissements|length }} établissement(s) — les écoles des trois îles.
                </p>
            </div>

            <a href="{{ path('app_etablissement_new') }}" class="btn-adm">+ Créer un établissement</a>
        </div>

        <form method="get" action="{{ path('app_etablissement_index') }}" class="flex flex-col gap-2 mb-6 sm:flex-row">
            <input
                type="search"
                name="q"
                value="{{ search }}"
                placeholder="Rechercher un enseignant, une classe, une matière…"
                class="flex-1 rounded border-2 bg-white px-4 py-2 text-slate-800 placeholder-slate-400 outline-none transition"
            >
            {# On conserve le tri courant pendant la recherche (sinon il se perd) #}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="order" value="{{ order }}">
            <button type="submit">
                <img src="{{ asset('Icônes/chercher.png') }}" alt="Un bouton en icône de recherche" class="w-8">
            </button>
            {% if search %}
                <a href="{{ path('app_affectation_index') }}" class="btn-header text-center">Effacer</a>
            {% endif %}
        </form>

        {# ══════════ TABLEAU ══════════ #}
        <div class="bg-white rounded-lg shadow-md p-6 border border-green-800">
            <div class="overflow-x-auto">
                <table class="min-w-150 w-full text-left">
                    <thead>
                        <tr class="border-b-2 border-vert-fonce">
                            <th class="px-4 py-3">{{ m.sortable('Nom', 'nom', 'app_etablissement_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">Type</th>
                            <th class="px-4 py-3">{{ m.sortable('Localité', 'localite', 'app_etablissement_index', sort, order, search) }}</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>                    <tbody class="divide-y divide-bleu/40">
                        {% for etablissement in etablissements %}
                            <tr class="hover:bg-menthe transition">
                                <td class="px-4 py-3 font-semibold">{{ etablissement.nom }}</td>

                                {# ── Badge de type : 3 couleurs, 3 niveaux ── #}
                                <td class="px-4 py-3">
                                    {% if etablissement.type == 'lycee' %}
                                        <span class="bg-vert/15 text-vert-fonce font-semibold text-xs px-2 py-1 rounded-full">Lycée</span>
                                    {% elseif etablissement.type == 'college' %}
                                        <span class="bg-bleu/20 text-vert-fonce border border-bleu font-semibold text-xs px-2 py-1 rounded-full">Collège</span>
                                    {% else %}
                                        <span class="bg-slate-200 text-slate-700 font-semibold text-xs px-2 py-1 rounded-full">Primaire</span>
                                    {% endif %}
                                </td>

                                <td class="px-4 py-3">
                                    {{ etablissement.localite.nom }}
                                    <span class="text-slate-400 text-xs">({{ etablissement.localite.ile }})</span>
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-6">
                                        <a href="{{ path('app_etablissement_show', {'id': etablissement.id}) }}">
                                            <img src="{{ asset('/Icônes/voir.png') }}" alt="Bouton en icône de voir le document" class="w-8">
                                        </a>

                                        <a href="{{ path('app_etablissement_edit', {'id': etablissement.id}) }}">
                                            <img src="{{ asset('/Icônes/modifier-le-document.png') }}" alt="Bouton en icône de modification" class="w-8">
                                        </a>

                                        {# ── SUPPRESSION : définitive → POST + CSRF + confirmation explicite ── #}
                                        <form
                                            method="post"
                                            action="{{ path('app_etablissement_delete', {'id': etablissement.id}) }}"
                                            onsubmit="return confirm('⚠️ Supprimer définitivement {{ etablissement.nom }} ? Cette action est irréversible.');"
                                        >
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etablissement.id) }}">
                                            <button><img src="{{ asset('/Icônes/supprimer.png') }}" alt="Bouton en icône de suppression" class="w-8 mt-2 cursor-pointer"></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            {# ── État vide ── #}
                            <tr>
                                <td colspan="4" class="px-4 py-12 text-center">
                                    <p class="text-4xl mb-2">🏫</p>
                                    <p class="text-slate-600 font-semibold">Aucun établissement</p>
                                    <p class="text-slate-500 text-sm mt-1">Commencez par créer le premier.</p>
                                    <a href="{{ path('app_etablissement_new') }}" class="btn mt-4">+ Créer un établissement</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
             {{ m.pagination('app_etablissement_index', page, totalPages, search, sort, order) }}
            </div>
        </div>

    </main>
{% endblock %}
