{% extends 'base.html.twig' %}

{% block title %}Créer un établissement — MEDUC{% endblock %}

{% block body %}
    <div class="flex flex-col gap-8 pb-16 md:px-16 lg:px-40">
        {# ══════════ EN-TÊTE : retour vers la LISTE (pas la fiche !) ══════════ #}
        <div class="mb-4">

            <a
                href="{{ path('app_etablissement_index') }}"
                class="inline-flex items-center gap-2 rounded-lg border border-blue-200
               bg-white px-4 py-2.5 text-sm font-semibold text-blue-700
                transition-colors hover:bg-blue-50 
                focus-visible:outline-none focus-visible:ring-2
                focus-visible:ring-blue-600 focus-visible:ring-offset-2 mb-16">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5"/>
                    <path d="m12 19-7-7 7-7"/>
                </svg>

                <span>Retour</span>
            </a>            
            
            <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">Créer un établissement</h1>
            <p class="text-slate-600 text-sm mt-1">
                Ajoutez une école et rattachez-la à une localité des trois îles.
            </p>
        </div>

        {# ⭐ novalidate : tes erreurs Symfony s'affichent #}
        {{ form_start(form, {attr: {novalidate: true}}) }}

        {# ══════════ CARTE UNIQUE ══════════ #}
        <section class="flex flex-col gap-4 bg-white rounded-lg shadow-md p-6 border-t border-green-800 mb-6 md:gap-8 md:px-16">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Informations générales</h2>

            <div class="flex flex-col gap-4 mt-4">
                <div class="sm:flex sm:flex-row sm:justify-between">
                    {{ form_row(form.nom) }}
                    {{ form_row(form.type) }}
                    {{ form_row(form.localite) }}
                </div>
                <div>
                    {{ form_widget(form.actif) }}
                </div>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row">
                <button type="submit" class="btn-adm">Créer l'établissement</button>
                <a href="{{ path('app_etablissement_index') }}" class="border-2 py-2 px-4 items-center justify-center rounded text-center text-white bg-red-500 hover:bg-red-600">Annuler</a>
            </div>

        </section>

        {{ form_end(form) }}
    </div>
{% endblock %}
