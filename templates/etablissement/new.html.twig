{% extends 'base.html.twig' %}

{% block title %}Créer un établissement — MEDUC{% endblock %}

{% block body %}
    <main class="container mx-auto px-4 py-8 max-w-3xl">

        {# ══════════ EN-TÊTE : retour vers la LISTE (pas la fiche !) ══════════ #}
        <div class="mb-6">
            <a href="{{ path('app_etablissement_index') }}" class="text-sm text-green-800 hover:underline">
                ← Retour aux établissements
            </a>
            <h1 class="font-display text-2xl font-bold text-vert-fonce mt-2">Créer un établissement</h1>
            <p class="text-slate-600 text-sm mt-1">
                Ajoutez une école et rattachez-la à une localité des trois îles.
            </p>
        </div>

        {# ⭐ novalidate : tes erreurs Symfony s'affichent #}
        {{ form_start(form, {attr: {novalidate: true}}) }}

        {# ══════════ CARTE UNIQUE ══════════ #}
        <section class="bg-white rounded-lg shadow-md p-6 border-t-2 border-green-800 mb-6">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Informations générales</h2>

            <div class="grid grid-cols-1 gap-4 mt-4 md:grid-cols-2">
                {{ form_row(form.nom) }}
                {{ form_row(form.type) }}
                {{ form_row(form.localite) }}
                <div class="md:col-span-2">
                    {{ form_widget(form.actif) }}
                </div>
            </div>
        </section>

        {# ══════════ ACTIONS ══════════ #}
        <div class="flex flex-col sm:flex-row gap-4">
            <button type="submit" class="btn-adm">Créer l'établissement</button>
            <a href="{{ path('app_etablissement_index') }}" class="px-4 py-2 rounded-xl bg-red-700 hover:bg-red-500 text-white text-center">Annuler</a>
        </div>

        {{ form_end(form) }}
    </main>
    {% include '_partials/_footer.html.twig' %}   

{% endblock %}
