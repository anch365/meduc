{% extends 'base.html.twig' %}

{% block title %}Etablissement{% endblock %}

{% block body %}
    <h1>Etablissement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ etablissement.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ etablissement.nom }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ etablissement.type }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ etablissement.actif ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ etablissement.createdAt ? etablissement.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ etablissement.updatedAt ? etablissement.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_etablissement_index') }}">Retour à la liste</a>

    <a href="{{ path('app_etablissement_edit', {'id': etablissement.id}) }}">Modifier</a>

    {{ include('etablissement/_delete_form.html.twig') }}
    
    <h2>Enseignants affectés ({{ affectations|length }})</h2>

    {% if affectations is empty %}
        <p>Aucun enseignant affecté actuellement.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Enseignant</th>
                    <th>Classe</th>
                    <th>Matière</th>
                    <th>Depuis le</th>
                </tr>
            </thead>
            <tbody>
                {% for affectation in affectations %}
                    <tr>
                        <td>{{ affectation.enseignant.utilisateur.prenom }} {{ affectation.enseignant.utilisateur.nom }}</td>
                        <td>{{ affectation.classe }}</td>
                        <td>{{ affectation.matiere }}</td>
                        <td>{{ affectation.dateDebut|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
