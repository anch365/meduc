{% extends 'base.html.twig' %}

{% block title %}{{ etablissement.nom }} — MEDUC{% endblock %}

{% block body %}
    <main class="container mx-auto px-4 py-8 md:px-8 lg:px-16">

        {# ══════════ EN-TÊTE ══════════ #}
        <div class="flex flex-col justify-between gap-4 mb-6 sm:flex-row sm:items-center">
            <div>
                <a href="{{ path('app_etablissement_index') }}" class="text-sm text-green-800 hover:underline">
                    <img src="{{ asset('/Icônes/retour.svg') }}" alt="Bouton en icone de reotur à la lsite des établissemnts" class="w-12">
                </a>
                
                <h1 class="font-display text-3xl font-bold text-vert-fonce mt-2">{{ etablissement.nom }}</h1>
                <p class="text-slate-600 text-sm mt-1">
                    {{ etablissement.localite.nom }} ({{ etablissement.localite.ile }})
                </p>
            </div>

            {# ── Badge type (même système que la liste) ── #}
            {% if etablissement.type == 'lycee' %}
                <span class="bg-vert/15 text-vert-fonce font-semibold text-sm px-3 py-1 rounded-full self-start">Lycée</span>
            {% elseif etablissement.type == 'college' %}
                <span class="bg-bleu/20 text-vert-fonce border border-bleu font-semibold text-sm px-3 py-1 rounded-full self-start">Collège</span>
            {% else %}
                <span class="bg-slate-200 text-slate-700 font-semibold text-sm px-3 py-1 rounded-full self-start">Primaire</span>
            {% endif %}
        </div>

        {# ══════════ CARTE "EN BREF" + INFOS ══════════ #}
        <section class="flex flex-col gap-6 mb-6 sm:flex-row sm:justify-between lg:px-16">

            {# Infos : 2/3 #}
            <div class="bg-white rounded-lg shadow-md p-6 border border-green-800 sm:px-8 md:w-full lg:px-16">
                <h2 class="font-display text-xl font-bold text-vert-fonce">Informations</h2>

                <dl class="flex flex-row justify-between mt-4 sm:gap-32 lg:gap-40">
                    <div class="flex flex-col gap-1">
                        <dt class="text-sm text-slate-500">Type</dt>
                        <dd class="font-semibold">{{ etablissement.type|capitalize }}</dd>
                    </div>
                    <div class="flex flex-col gap-1">
                        <dt class="text-sm text-slate-500">Localité</dt>
                        <dd class="font-semibold">{{ etablissement.localite.nom }}</dd>
                    </div>
                </dl>

                <dl class="flex flex-row justify-between mt-4 sm:gap-32 lg:gap-40">
                    <div class="flex flex-col gap-1">
                        <dt class="text-sm text-slate-500">Île</dt>
                        <dd class="font-semibold">{{ etablissement.localite.ile }}</dd>
                    </div>
                    <div class="flex flex-col gap-1">
                        <dt class="text-sm text-slate-500">Créé le</dt>
                        <dd class="font-semibold">{{ etablissement.createdAt ? etablissement.createdAt|date('d/m/Y') : '—' }}</dd>
                    </div>
                </dl>
            </div>

            {# En bref : 1/3 #}
            <div class="bg-white rounded-lg shadow-md p-6 border flex flex-col md:w-full lg:px-16">
                <h2 class="font-display text-xl font-bold text-vert-fonce">En bref</h2>
                <p class="font-display text-4xl font-bold text-vert-fonce mt-4">{{ affectations|length }}</p>
                <p class="text-slate-600 text-sm">enseignant(s) en poste</p>
                <a href="{{ path('app_affectation_new') }}" class="btn-adm mt-auto">+ Affecter un enseignant</a>
            </div>
        </section>

        {# ══════════ TABLEAU : LES ENSEIGNANTS EN POSTE (M6.9) ══════════ #}
        <section class="bg-white rounded-lg shadow-md p-6 border-t-2 border-green-800">
            <h2 class="font-display text-xl font-bold text-vert-fonce">Enseignants en poste</h2>

            <div class="overflow-x-auto mt-4">
                <table class="min-w-150 w-full text-left">
                    <thead>
                        <tr class="border-b-2 border-vert-fonce">
                            <th class="px-4 py-3">Matricule</th>
                            <th class="px-4 py-3">Nom</th>
                            <th class="px-4 py-3">Prénom</th>
                            <th class="px-4 py-3">Classe</th>
                            <th class="px-4 py-3">Matière</th>
                            <th class="px-4 py-3">Depuis le</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bleu/40">
                        {% for affectation in affectations %}
                            <tr class="hover:bg-menthe transition">
                                <td class="px-4 py-3">{{ affectation.enseignant.utilisateur.matricule }}</td>
                                <td class="px-4 py-3 font-semibold">{{ affectation.enseignant.utilisateur.nom }}</td>
                                <td class="px-4 py-3">{{ affectation.enseignant.utilisateur.prenom }}</td>
                                <td class="px-4 py-3">{{ affectation.classe }}</td>
                                <td class="px-4 py-3">{{ affectation.matiere }}</td>
                                <td class="px-4 py-3">{{ affectation.dateDebut|date('d/m/Y') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-12 text-center">
                                    <p class="text-4xl mb-2">🏫</p>
                                    <p class="text-slate-600 font-semibold">Aucun enseignant en poste</p>
                                    <p class="text-slate-500 text-sm mt-1">
                                        Affectez un enseignant à cet établissement pour le voir apparaître ici.
                                    </p>
                                    <a href="{{ path('app_affectation_new') }}" class="btn mt-4">+ Affecter un enseignant</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# ══════════ ACTIONS ══════════ #}
        <div class="flex flex-wrap gap-4 mt-8">
            <a href="{{ path('app_etablissement_edit', {'id': etablissement.id}) }}" class="btn">Modifier</a>

            <form
                method="post"
                action="{{ path('app_etablissement_delete', {'id': etablissement.id}) }}"
                onsubmit="return confirm('⚠️ Supprimer définitivement {{ etablissement.nom }} ? Cette action est irréversible.');"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etablissement.id) }}">
                <button class="text-red-700 hover:text-white hover:bg-red-700 rounded-xl p-2 border-2 border-red-700 font-semibold">Supprimer</button>
            </form>
        </div>
    </main>

    {% include '_partials/_footer.html.twig' %}   

{% endblock %}
