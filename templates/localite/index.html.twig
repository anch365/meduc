{% extends 'base.html.twig' %}

{% block title %}Localite index{% endblock %}

{% block body %}
    <section class="flex-1">
        <h1 class="text-2xl font-bold text-vert-fonce mb-6">Localités (villes &amp; villages des Comores)</h1>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Ile</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
                {% for localite in localites %}
                    <tr>
                        <td>{{ localite.id }}</td>
                        <td>{{ localite.nom }}</td>
                        <td>{{ localite.ile }}</td>
                        <td>
                            <a href="{{ path('app_localite_show', {'id': localite.id}) }}">Voir</a>
                            <a href="{{ path('app_localite_edit', {'id': localite.id}) }}">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_localite_new') }}">Créer un nouveau</a>
    </section>
{% endblock %}
