{% extends 'base.html.twig' %}

{% block title %}Localite{% endblock %}

{% block body %}
    <h1>Localite</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ localite.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ localite.nom }}</td>
            </tr>
            <tr>
                <th>Ile</th>
                <td>{{ localite.ile }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_localite_index') }}">Retour à la liste</a>

    <a href="{{ path('app_localite_edit', {'id': localite.id}) }}">Modifier</a>

    {{ include('localite/_delete_form.html.twig') }}
{% endblock %}
