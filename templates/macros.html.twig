{# ══════════ MACROS PARTAGÉES : tri + pagination pour toutes les listes ══════════ #}

{% macro sortable(label, field, route, sort, order, search) %}
    {% set active = sort == field %}
    {% set nextOrder = active and order == 'ASC' ? 'DESC' : 'ASC' %}
    <a
        href="{{ path(route, {sort: field, order: nextOrder, q: search, page: 1}) }}"
        class="group inline-flex items-center gap-2 hover:text-vert transition"
        aria-label="Trier par {{ label }}{% if active %}, actuellement {{ order == 'ASC' ? 'croissant' : 'décroissant' }}{% endif %}"
    >
        <span class="{{ active ? 'text-vert-fonce font-semibold' : 'text-slate-700 group-hover:text-vert' }}">{{ label }}</span>
        <span class="flex flex-col text-[9px] leading-none" aria-hidden="true">
            <span class="{{ active and order == 'ASC' ? 'text-vert' : 'text-slate-300' }}">▲</span>
            <span class="{{ active and order == 'DESC' ? 'text-vert' : 'text-slate-300' }}">▼</span>
        </span>
    </a>
{% endmacro %}

{% macro pagination(route, page, totalPages, search, sort, order) %}
    {% if totalPages > 1 %}
        <nav class="flex flex-row gap-8 justify-center items-center mt-6 md:gap-16" aria-label="Pagination">
            <a
                href="{{ path(route, {page: page - 1, q: search, sort: sort, order: order}) }}"
                class="w-6 {{ page <= 1 ? 'pointer-events-none opacity-50' : '' }}"
            >
                <img src="{{ asset('/Icônes/left-arrow.png') }}" alt="Flêche direction de gauche pour paginer à gauche dans la liste">
            </a>

            <p class="text-sm md:text-xl">Page {{ page }} / {{ totalPages }}</p>
            <a
                href="{{ path(route, {page: page + 1, q: search, sort: sort, order: order}) }}"
                class="w-6 {{ page >= totalPages ? 'pointer-events-none opacity-50' : '' }}"
            >
                <img src="{{ asset('Icônes/right-arrow.png') }}" alt="Flêche directioon de droite pour paginer à droite dans la liste">
            </a>
        </nav>
    {% endif %}
{% endmacro %}
