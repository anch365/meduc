{# ══════════ MACROS PARTAGÉES : tri + pagination pour toutes les listes ══════════ #}

{% macro sortable(label, field, route, sort, order, search) %}
    {% set active = sort == field %}
    {% set nextOrder = active and order == 'ASC' ? 'DESC' : 'ASC' %}
    <a
        href="{{ path(route, {sort: field, order: nextOrder, q: search, page: 1}) }}"
        class="group inline-flex items-center gap-2 hover:text-vert transition"
        aria-label="Trier par {{ label }}{% if active %}, actuellement {{ order == 'ASC' ? 'croissant' : 'décroissant' }}{% endif %}"
    >
        <span class="{{ active ? 'text-vert-fonce font-semibold' : 'text-slate-700 group-hover:text-vert' }}">{{ label }}</span>
        <span class="flex flex-col text-[9px] leading-none" aria-hidden="true">
            <span class="{{ active and order == 'ASC' ? 'text-vert' : 'text-slate-300' }}">▲</span>
            <span class="{{ active and order == 'DESC' ? 'text-vert' : 'text-slate-300' }}">▼</span>
        </span>
    </a>
{% endmacro %}

{% macro pagination(route, page, totalPages, search, sort, order) %}
    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 mt-6" aria-label="Pagination">

            {# ── Flèche PRÉCÉDENTE : SVG inline (plus de PNG !) ── #}
            <a href="{{ path(route, {page: page - 1, q: search, sort: sort, order: order}) }}"
               aria-label="Page précédente"
               class="mr-2 md:mr-4 {{ page <= 1 ? 'pointer-events-none opacity-40' : '' }}">
                <svg width="9" height="16" viewBox="0 0 12 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M11 1L2 9.24242L11 17" stroke="#00792D" stroke-opacity="0.7" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </a>

            {# ── Les NUMÉROS DE PAGE : générés dynamiquement ! ── #}
            <div class="flex flex-wrap justify-center gap-2 text-sm text-vert-fonce md:text-base">
                {% for p in 1..totalPages %}
                    <a href="{{ path(route, {page: p, q: search, sort: sort, order: order}) }}"
                       {% if p == page %}aria-current="page"{% endif %}
                       class="flex items-center justify-center active:scale-95
                              w-9 md:w-12 h-9 md:h-12 aspect-square rounded-md transition-all
                              {{ p == page
                                  ? 'bg-indigo-600 text-white font-semibold hover:bg-indigo-500'
                                  : 'bg-white border border-bleu/40 hover:bg-menthe' }}">
                        {{ p }}
                    </a>
                {% endfor %}
            </div>

            {# ── Flèche SUIVANTE : SVG inline ── #}
            <a href="{{ path(route, {page: page + 1, q: search, sort: sort, order: order}) }}"
               aria-label="Page suivante"
               class="ml-2 md:ml-4 {{ page >= totalPages ? 'pointer-events-none opacity-40' : '' }}">
                <svg width="9" height="16" viewBox="0 0 12 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1 1L10 9.24242L1 17" stroke="#00792D" stroke-opacity="0.7" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </a>
        </nav>
    {% endif %}
{% endmacro %}